{
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make setup)",
      "Bash(make migrate)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(python3 -m unittest *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bloquear-segredos.py\"",
            "if": "Bash(git commit *)",
            "timeout": 20,
            "statusMessage": "Gate: procurando segredos e dados pessoais no commit..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-testes.sh\"",
            "if": "Bash(git commit *)",
            "timeout": 240,
            "statusMessage": "Gate: rodando make test antes do commit..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-testes.sh\"",
            "if": "Bash(git push *)",
            "timeout": 240,
            "statusMessage": "Gate: rodando make test antes do push..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/require-skill-author.py\"",
            "if": "Write(**/SKILL.md)",
            "timeout": 10,
            "statusMessage": "Gate: checando autoria da Skill..."
          }
        ]
      }
    ]
  }
}
