# =============================================================================
# Bot Oráculo — Atena v1.0 | Modelo de variáveis de ambiente
# TD-001 / RNF-003: segredos NUNCA no código. Copie para `.env` e preencha.
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
ORACULO_ENV=development           # development | staging | production
ORACULO_LOG_LEVEL=INFO
ORACULO_RUN_BOT=true              # sobe o cliente Discord
ORACULO_RUN_API=true              # sobe a API/webhooks FastAPI

# --- Discord (RF-001) --------------------------------------------------------
ORACULO_DISCORD_TOKEN=
ORACULO_DISCORD_GUILD_IDS=        # ex.: 123456789,987654321 (vazio = sync global)
ORACULO_DISCORD_LOG_CHANNEL_ID=   # canal #logs-oráculo (US-401 / RF-012)

# Bootstrap do 1º Administrador (RN-008), lido uma vez no start do bot.
# Alternativa a `python -m oraculo promover-admin` para quem só tem acesso ao
# painel de variáveis do deploy. Sem efeito se já existir um Administrador
# ativo — seguro deixar preenchido entre deploys, ou apagar depois de usar.
ORACULO_BOOTSTRAP_ADMIN_DISCORD_ID=

# --- Banco de dados (TD-002 / ADR-001) ---------------------------------------
# Produção: postgresql+asyncpg://usuario:senha@host:5432/oraculo
# Dev/testes: sqlite+aiosqlite:///./data/oraculo.sqlite3
ORACULO_DATABASE_URL=sqlite+aiosqlite:///./data/oraculo.sqlite3
ORACULO_DB_ECHO=false

# --- Cache (US-404 / RNF-001) ------------------------------------------------
ORACULO_REDIS_URL=                # vazio = cache em memória (fallback)
ORACULO_RANKING_CACHE_TTL=60

# --- API / Webhooks (TD-003 / RNF-003) ---------------------------------------
ORACULO_API_HOST=0.0.0.0
ORACULO_API_PORT=8000
ORACULO_CLICKUP_WEBHOOK_SECRET=   # segredo HMAC-SHA256 do header X-Signature
ORACULO_WEBHOOK_MAX_SKEW_SECONDS=300

# --- Google Agenda (RN-009 / RF-011) -----------------------------------------
ORACULO_GOOGLE_ENABLED=false
ORACULO_GOOGLE_CALENDAR_ID=primary
ORACULO_GOOGLE_CREDENTIALS_FILE=  # caminho do JSON de service account / OAuth2
ORACULO_GOOGLE_TIMEZONE=America/Sao_Paulo

# --- Plataforma de membros: Firebase (RF-001) --------------------------------
# Vazio = integração desligada; nada é consultado.
ORACULO_FIREBASE_PROJECT_ID=
# JSON da service account (Firebase → Configurações → Contas de serviço).
# Se vazio, usa ORACULO_GOOGLE_CREDENTIALS_FILE e, por fim, as credenciais
# padrão do ambiente. NUNCA versione este arquivo (TD-001 / RNF-003).
ORACULO_FIREBASE_CREDENTIALS_FILE=
ORACULO_FIREBASE_COLECAO=membros

# Mapa campo interno -> campo do documento, em JSON. Só é preciso declarar os
# que diferem do padrão: id, nome, discordId, email, cargo, xp, ativo.
# Aceita caminho aninhado, ex.: "discord.id".
# ORACULO_FIREBASE_CAMPOS={"nome":"displayName","discord_id":"discord.id","xp":"pontos"}
ORACULO_FIREBASE_CAMPOS=

# Quem manda em XP e cargo:
#   cadastro      -> plataforma manda no cadastro; XP e cargo ficam com o bot (padrão)
#   carga_inicial -> XP e cargo vêm da plataforma só para membros novos
#   espelho       -> o XP é reflexo da plataforma e o cargo decorre dele (RN-002).
#                    Neste modo /conceder-xp e /remover-xp são recusados: o saldo
#                    seria sobrescrito na sincronização seguinte.
ORACULO_IMPORTACAO_POLITICA=cadastro

# Sincronização periódica dentro do processo do bot. 0 desliga o ciclo.
ORACULO_IMPORTACAO_INTERVALO_HORAS=6
ORACULO_IMPORTACAO_AO_INICIAR=true

# --- Pergunta ao Oráculo: LLM + projetos (RN-017) ----------------------------
# Vazio = /perguntar desligado. NUNCA versione esta chave (TD-001 / RNF-003).
ORACULO_ANTHROPIC_API_KEY=
ORACULO_LLM_MODEL=claude-opus-5
ORACULO_LLM_MAX_TOKENS=4000

# Diretório com os .md do regulamento TYTO (o vault Institucional/).
# Vazio = o bot avisa que a base de regras não está configurada.
ORACULO_REGRAS_DIR=

# PostgreSQL EXTERNO (somente leitura) com os dados dos projetos.
# Use um usuário com apenas SELECT nas tabelas do contrato (ver README):
#   projetos(id, nome, descricao, status, atualizado_em)
#   projeto_decisoes(id, projeto_id, titulo, conteudo, decidido_em)
# Vazio = perguntas sobre projetos ficam indisponíveis; regras TYTO seguem valendo.
ORACULO_PROJETOS_DATABASE_URL=

# Freio de custo: perguntas por pessoa por hora (0 = sem limite).
ORACULO_PERGUNTA_LIMITE_HORA=10

# --- E-mail (RF-010) ---------------------------------------------------------
ORACULO_SMTP_HOST=
ORACULO_SMTP_PORT=587
ORACULO_SMTP_USER=
ORACULO_SMTP_PASSWORD=
ORACULO_SMTP_FROM=oraculo@clubetyto.example

# --- Backup (RNF-005 / US-402) -----------------------------------------------
ORACULO_BACKUP_ENABLED=false
ORACULO_BACKUP_DIR=./backups
ORACULO_BACKUP_HOUR_UTC=6
ORACULO_BACKUP_RETENTION_DAYS=14
